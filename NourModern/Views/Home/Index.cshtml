@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حضانة نور الحديثة</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@@400;500;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <style>
        :root {
            --nour-amber: #f59e0b;
            --nour-orange: #f97316;
            --nour-ink: #3d2c1e;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            min-height: 100vh;
            color: var(--nour-ink);
            background: linear-gradient(160deg, #e0f2fe 0%, #fff7ed 45%, #ffedd5 100%);
            background-attachment: fixed;
            padding: 2.5rem 1rem;
        }

        .form-card {
            max-width: 640px;
            margin: 0 auto;
            background: #fff;
            border-radius: 1.25rem;
            box-shadow: 0 1rem 3rem rgba(124, 80, 20, 0.15);
            padding: 2.5rem 2rem;
            animation: card-in .5s ease-out;
        }

        @@keyframes card-in {
            from { opacity: 0; transform: translateY(14px); }
            to { opacity: 1; transform: none; }
        }

        .logo-frame {
            width: 110px;
            height: 110px;
            margin: 0 auto 1rem;
            border-radius: 50%;
            overflow: hidden;
            border: 4px solid #fde68a;
            box-shadow: 0 .5rem 1.25rem rgba(245, 158, 11, 0.35);
        }

            .logo-frame img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        h1 {
            text-align: center;
            font-weight: 800;
            font-size: 1.75rem;
            margin-bottom: .25rem;
        }

        .subtitle {
            text-align: center;
            color: #92702f;
            margin-bottom: 1.75rem;
        }

        .form-floating > label {
            font-weight: 500;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--nour-amber);
            box-shadow: 0 0 0 .25rem rgba(245, 158, 11, 0.2);
        }

        .btn-send {
            width: 100%;
            border: 0;
            border-radius: .75rem;
            padding: .8rem;
            font-size: 1.15rem;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, var(--nour-amber), var(--nour-orange));
            box-shadow: 0 .5rem 1rem rgba(249, 115, 22, 0.3);
            transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
        }

            .btn-send:hover:not(:disabled) {
                filter: brightness(1.06);
                transform: translateY(-2px);
                box-shadow: 0 .75rem 1.4rem rgba(249, 115, 22, 0.38);
            }

            .btn-send:active:not(:disabled) {
                transform: translateY(0);
            }

            .btn-send:disabled {
                opacity: .75;
            }

        .required-note {
            color: #b45309;
            font-size: .9rem;
            margin-bottom: 1rem;
        }

            .required-note .star,
            .form-floating .star {
                color: #dc3545;
            }

        @@media (max-width: 575.98px) {
            .form-card {
                padding: 1.75rem 1.25rem;
            }
        }
    </style>
</head>
<body>
    <main class="form-card">
        <div class="logo-frame">
            <img src="~/Sun2.jpg" alt="شعار الحضانة">
        </div>
        <h1>حضانة نور الحديثة</h1>
        <p class="subtitle">نموذج طلب التقديم — يسعدنا انضمام طفلكم إلينا</p>

        <div id="formAlert"></div>

        <form id="nurseryApplicationForm" novalidate>
            <div class="form-floating mb-3">
                <select class="form-select" id="applicationType" name="applicationType" required>
                    <option value="طلب جديد" selected>طلب جديد</option>
                    <option value="طلب قديم">طلب قديم</option>
                </select>
                <label for="applicationType">نوع الطلب <span class="star">*</span></label>
            </div>

            <div class="form-floating mb-3">
                <input type="text" class="form-control" id="fullName" name="fullName" placeholder="الاسم الكامل" required>
                <label for="fullName">الاسم الكامل للطفل <span class="star">*</span></label>
                <div class="invalid-feedback">يرجى إدخال الاسم الكامل (كلمتين على الأقل).</div>
            </div>

            <div class="form-floating mb-3">
                <input type="text" class="form-control" id="MatherName" name="MatherName" placeholder="اسم الأم" required>
                <label for="MatherName">اسم الأم <span class="star">*</span></label>
                <div class="invalid-feedback">يرجى إدخال اسم الأم.</div>
            </div>

            <div class="form-floating mb-3">
                <input type="text" inputmode="numeric" maxlength="14" class="form-control" id="KidId" name="KidId" placeholder="الرقم القومي" required>
                <label for="KidId">الرقم القومي للطفل <span class="star">*</span></label>
                <div class="invalid-feedback">يجب أن يتكون الرقم القومي من 14 رقمًا.</div>
            </div>

            <div class="form-floating mb-3">
                <input type="number" min="1" max="6" class="form-control" id="age" name="age" placeholder="العمر" required>
                <label for="age">العمر (بالسنوات) <span class="star">*</span></label>
                <div class="invalid-feedback">يرجى إدخال عمر صحيح من 1 إلى 6 سنوات.</div>
            </div>

            <div class="form-floating mb-3">
                <input type="tel" inputmode="numeric" maxlength="11" class="form-control" id="phone" name="phone" placeholder="رقم الهاتف" required>
                <label for="phone">رقم الهاتف <span class="star">*</span></label>
                <div class="invalid-feedback">يرجى إدخال رقم هاتف صحيح (يبدأ بـ 01 ويتكون من 11 رقمًا).</div>
            </div>

            <div class="required-note"><span class="star">*</span> تشير إلى أن الحقل مطلوب</div>

            <button type="submit" class="btn-send" id="submitBtn">
                <span id="submitText">إرسال الطلب</span>
            </button>
        </form>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            'use strict';

            var form = document.getElementById('nurseryApplicationForm');
            var submitBtn = document.getElementById('submitBtn');
            var submitText = document.getElementById('submitText');
            var alertBox = document.getElementById('formAlert');

            var validators = {
                fullName: function (v) { return /\S+\s+\S+/.test(v.trim()); },
                MatherName: function (v) { return v.trim().length > 0; },
                KidId: function (v) { return /^\d{14}$/.test(v.trim()); },
                age: function (v) {
                    var n = Number(v);
                    return Number.isInteger(n) && n >= 1 && n <= 6;
                },
                phone: function (v) { return /^01\d{9}$/.test(v.trim()); }
            };

            function validateField(field) {
                var check = validators[field.name];
                if (!check) { return true; }
                var ok = check(field.value);
                field.classList.toggle('is-invalid', !ok);
                field.classList.toggle('is-valid', ok);
                return ok;
            }

            Object.keys(validators).forEach(function (name) {
                var field = form.elements[name];
                field.addEventListener('blur', function () { validateField(field); });
                field.addEventListener('input', function () {
                    if (field.classList.contains('is-invalid')) { validateField(field); }
                });
            });

            function clearValidation() {
                Array.prototype.forEach.call(form.querySelectorAll('.is-valid, .is-invalid'), function (el) {
                    el.classList.remove('is-valid', 'is-invalid');
                });
            }

            function showAlert(type, message) {
                alertBox.innerHTML =
                    '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
                    message +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>' +
                    '</div>';
                alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            function setSending(sending) {
                submitBtn.disabled = sending;
                submitText.innerHTML = sending
                    ? '<span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span> جاري الإرسال...'
                    : 'إرسال الطلب';
            }

            form.addEventListener('submit', function (event) {
                event.preventDefault();

                var firstInvalid = null;
                Object.keys(validators).forEach(function (name) {
                    var field = form.elements[name];
                    if (!validateField(field) && !firstInvalid) { firstInvalid = field; }
                });

                if (firstInvalid) {
                    firstInvalid.focus();
                    return;
                }

                setSending(true);
                alertBox.innerHTML = '';

                fetch('/Home/SendEmail', {
                    method: 'POST',
                    body: new URLSearchParams(new FormData(form))
                })
                    .then(function (response) {
                        if (!response.ok) { throw new Error('HTTP ' + response.status); }
                        return response.json();
                    })
                    .then(function (data) {
                        if (data.success) {
                            showAlert('success', 'تم إرسال الطلب بنجاح! سنتواصل معكم قريبًا.');
                            form.reset();
                            clearValidation();
                        } else {
                            showAlert('danger', 'فشل في إرسال الطلب، حاول مرة أخرى.');
                        }
                    })
                    .catch(function () {
                        showAlert('danger', 'فشل في إرسال الطلب، تأكد من الاتصال بالإنترنت وحاول مرة أخرى.');
                    })
                    .finally(function () {
                        setSending(false);
                    });
            });
        })();
    </script>
</body>
</html>
