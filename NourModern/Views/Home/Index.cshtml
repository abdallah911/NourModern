@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حضانة نور الحديثة</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f0f8ff;
            padding: 20px;
            direction: rtl;
            text-align: right;
        }

        .container {
            max-width: 800px;
            margin: auto;
            background: #f9f9f9;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .form-group label {
            font-weight: bold;
        }

            .form-group label span {
                color: red;
            }

        .btn-primary {
            width: 100%;
            background-color: #007bff;
            border-color: #007bff;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
            color: #007bff;
        }

        .logo {
            display: block;
            margin: 0 auto 20px;
            max-width: 150px;
        }

        .note {
            color: red;
            font-weight: bold;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>
    <div class="container">
        <img src="~/Sun2.jpg" alt="شعار الحضانة" class="logo">
        <h1>حضانة نور الحديثة</h1>
        <form id="nurseryApplicationForm">
            <div class="form-group row">
                <label for="applicationType" class="col-sm-3 col-form-label">نوع الطلب: <span>*</span></label>
                <div class="col-sm-9">
                    <select class="form-control" id="applicationType" name="applicationType" required>
                        <option value="طلب جديد">طلب جديد</option>
                        <option value="طلب قديم">طلب قديم</option>
                    </select>
                </div>
            </div>
            <div class="form-group row">
                <label for="fullName" class="col-sm-3 col-form-label">الاسم الكامل: <span>*</span></label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" id="fullName" name="fullName" required>
                </div>
            </div>
            <div class="form-group row">
                <label for="MatherName" class="col-sm-3 col-form-label">اسم الام: <span>*</span></label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" id="MatherName" name="MatherName" required>
                </div>
            </div>
            <div class="form-group row">
                <label for="KidId" class="col-sm-3 col-form-label">الرقم القومي للطفل: <span>*</span></label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" id="KidId" name="KidId" required>
                </div>
            </div>
            <div class="form-group row">
                <label for="age" class="col-sm-3 col-form-label">العمر: <span>*</span></label>
                <div class="col-sm-9">
                    <input type="number" class="form-control" id="age" name="age" required>
                </div>
            </div>
            <div class="form-group row">
                <label for="phone" class="col-sm-3 col-form-label">رقم الهاتف: <span>*</span></label>
                <div class="col-sm-9">
                    <input type="tel" class="form-control" id="phone" name="phone" required>
                </div>
            </div>
            <div class="note">* تشير الي ان السؤال مطلوب</div>
            <button type="submit" class="btn btn-primary">إرسال</button>
        </form>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#nurseryApplicationForm').on('submit', function (event) {
                event.preventDefault();

                $.ajax({
                    url: '/Home/SendEmail',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        alert('تم إرسال النموذج بنجاح!');
                        $('#nurseryApplicationForm')[0].reset();
                    },
                    error: function (xhr, status, error) {
                        alert('فشل في إرسال النموذج، حاول مرة أخرى.');
                    }
                });
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
